! {{.hostname}}: leaf at {{.site}} rack {{.rack}}, generated by ztpd
hostname {{.hostname}}
dns domain {{.domain}}
!
username admin privilege 15 role network-admin secret {{env "ZTP_ADMIN_SECRET"}}
!
{{range .ntp}}ntp server {{.}}
{{end}}
logging host {{.syslog}}
snmp-server location {{.snmp_location}}, rack {{.rack}}
!
service routing protocols model multi-agent
ip routing
!
{{range .server_vlans}}vlan {{.id}}
   name {{.name}}
{{end}}
!
interface Management1
   ip address {{.mgmt_ip}}
ip route 0.0.0.0/0 {{nthhost .mgmt_ip 1}}
!
interface Loopback0
   ip address {{.loopback}}
!
interface Ethernet49/1
   description spine1
   no switchport
   ip address {{nthhost (printf "%s/31" .spine1_ip) 1}}/31
!
interface Ethernet50/1
   description spine2
   no switchport
   ip address {{nthhost (printf "%s/31" .spine2_ip) 1}}/31
!
{{range seq 1 .server_ports}}interface Ethernet{{.}}
   switchport mode trunk
   switchport trunk allowed vlan {{join "," (vlanids $.server_vlans)}}
   spanning-tree portfast
{{end}}
!
router bgp {{.asn}}
   router-id {{ip .loopback}}
   maximum-paths 2
   neighbor SPINE peer group
   neighbor SPINE remote-as {{.spine_asn}}
   neighbor SPINE send-community
   neighbor {{.spine1_ip}} peer group SPINE
   neighbor {{.spine2_ip}} peer group SPINE
   network {{.loopback}}
!
end
