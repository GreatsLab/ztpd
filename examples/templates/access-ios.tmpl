! {{.hostname}}: {{.role}} switch at {{.site}}, generated by ztpd
{{template "ios-base" .}}
!
{{range .vlans}}vlan {{.id}}
 name {{.name}}
{{end}}
!
interface Vlan{{.mgmt_vlan}}
 description management
 ip address {{ip .mgmt_ip}} {{mask .mgmt_ip}}
 no shutdown
ip default-gateway {{nthhost .mgmt_ip 1}}
!
{{range .uplinks}}interface {{.}}
 description uplink
 switchport mode trunk
 switchport trunk allowed vlan {{join "," (vlanids $.vlans)}}
 no shutdown
{{end}}
!
interface range GigabitEthernet1/0/1 - {{.access_ports}}
 switchport mode access
 switchport access vlan {{.data_vlan}}
 switchport voice vlan {{.voice_vlan}}
 spanning-tree portfast
 spanning-tree bpduguard enable
!
spanning-tree mode rapid-pvst
end
